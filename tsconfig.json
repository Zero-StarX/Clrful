{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Node",
    "outDir": "dist",
    "declaration": true,
    "removeComments": true,
    "sourceMap": false,
    "declarationMap": false,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "function.ts"],
  "exclude": ["node_modules", "dist"]
}
